 #include "SDL_egl_c.h"
 #include "../SDL_hints_c.h"
 
+#ifdef SDL_VIDEO_DRIVER_ANDROID
+/* Mobilix patch: Android has no desktop OpenGL, only OpenGL ES. Minecraft asks for a desktop core profile, but the game's GL calls
+ * go through MobileGlues, which translates them to GLES, so SDL has to create an ES 3.x context for any request.
+ * While the context is being made, gl_config says "ES 3.0"; afterwards the values the game asked for are put back, so that
+ * SDL_GL_GetAttribute() tells the game what it requested (it checks the version it gets). */
+static struct { bool forced; int profile, major, minor, flags; } mobilix_req;
+
+static void Mobilix_ForceES(SDL_VideoDevice *_this)
+{
+    if (_this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_ES) {
+        return;
+    }
+    mobilix_req.forced = true;
+    mobilix_req.profile = _this->gl_config.profile_mask;
+    mobilix_req.major = _this->gl_config.major_version;
+    mobilix_req.minor = _this->gl_config.minor_version;
+    mobilix_req.flags = _this->gl_config.flags;
+    _this->gl_config.profile_mask = SDL_GL_CONTEXT_PROFILE_ES;
+    _this->gl_config.major_version = 3;
+    _this->gl_config.minor_version = 0;
+    _this->gl_config.flags &= ~SDL_GL_CONTEXT_FORWARD_COMPATIBLE_FLAG;
+}
+
+static void Mobilix_RestoreRequested(SDL_VideoDevice *_this)
+{
+    if (!mobilix_req.forced) {
+        return;
+    }
+    mobilix_req.forced = false;
+    _this->gl_config.profile_mask = mobilix_req.profile;
+    _this->gl_config.major_version = mobilix_req.major;
+    _this->gl_config.minor_version = mobilix_req.minor;
+    _this->gl_config.flags = mobilix_req.flags;
+}
+#define MOBILIX_FORCE_ES(t) Mobilix_ForceES(t)
+#define MOBILIX_RESTORE(t) Mobilix_RestoreRequested(t)
+#else
+#define MOBILIX_FORCE_ES(t) ((void)0)
+#define MOBILIX_RESTORE(t) ((void)0)
+#endif
+
