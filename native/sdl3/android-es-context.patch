+static SDL_GLContext SDL_EGL_CreateContextInner(SDL_VideoDevice *_this, EGLSurface egl_surface)
+{
+    MOBILIX_FORCE_ES(_this);
     // max 16 key+value pairs plus terminator.
     EGLint attribs[33];
     int attr = 0;
